# Non-secret environment selector for local development.
QC2_ENV=development

# No database URL or provider credential is supplied by this bootstrap.
# The API server uses the owner_api runtime role for projections and a separate
# identity runtime role for owner-session checks and signed command mutations.
# Configure QC2_AUTHORITY=owner_api, QC2_EXPECTED_DATABASE_DEVELOPMENT, and
# distinct QC2_DATABASE_URL_DEVELOPMENT_OWNER_API and
# QC2_DATABASE_URL_DEVELOPMENT_IDENTITY values through the workspace secrets
# flow. Do not reuse one authority's database URL for the other.
#
# Owner command challenge issuance also fails closed unless
# QC2_OWNER_COMMAND_CHALLENGE_TTL_SECONDS is explicitly configured to match
# the identity policy (1-300 seconds).
