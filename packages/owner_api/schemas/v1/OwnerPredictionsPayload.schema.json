{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qc2.owner_api.OwnerPredictionsPayload.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "rank",
    "instrument_ref",
    "symbol",
    "prediction_state",
    "score",
    "uncertainty",
    "excluded_reason",
    "evidence_refs"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "format": "date"
    },
    "rank": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "instrument_ref": {
      "$ref": "#/$defs/sourceRef"
    },
    "symbol": {
      "type": ["string", "null"],
      "maxLength": 16
    },
    "prediction_state": {
      "enum": ["SCORED", "UNSCORABLE", "EXCLUDED", "MISSING"]
    },
    "score": {
      "type": ["string", "null"],
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 64
    },
    "uncertainty": {
      "type": ["string", "null"],
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 64
    },
    "excluded_reason": {
      "type": ["string", "null"],
      "maxLength": 256
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/sourceRef"}
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_schema_name", "target_id"],
      "properties": {
        "target_schema_name": {"type": "string", "minLength": 1, "maxLength": 160},
        "target_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
