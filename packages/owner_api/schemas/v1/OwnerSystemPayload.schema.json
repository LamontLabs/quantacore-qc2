{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qc2.owner_api.OwnerSystemPayload.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["component", "state", "observed_at", "reason_codes", "fresh_until"],
  "properties": {
    "component": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "state": {
      "enum": ["BOOTING", "RECOVERY", "READY", "DEGRADED", "HOLD", "OFFLINE"]
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "reason_codes": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "fresh_until": {"type": ["string", "null"], "format": "date-time"}
  }
}
